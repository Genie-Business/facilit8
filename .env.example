# Database (Neon Postgres). Use the pooled connection string for DATABASE_URL
# (used at runtime by the app) and the unpooled one for DIRECT_URL (used by
# `prisma migrate`).
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# NextAuth — NEXTAUTH_URL must always point at the apex domain (login/signup live there),
# never the app subdomain, even though signed-in users land on app.usefacilit8.training.
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Site domains — the marketing/auth/admin apex, and the authenticated app subdomain.
NEXT_PUBLIC_SITE_URL="https://usefacilit8.training"
NEXT_PUBLIC_APP_URL="https://app.usefacilit8.training"

# Anchor (Nigerian banking-as-a-service) — see plan §6
ANCHOR_SECRET_KEY=""
ANCHOR_BASE_URL="https://api.sandbox.getanchor.co/api/v1"
ANCHOR_WEBHOOK_SECRET=""
ANCHOR_SETTLEMENT_ACCOUNT_ID=""

# Pusher (realtime notifications + chat) — see plan §5
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="Facilit8 <no-reply@facilit8.example>"

# Vercel Blob (file storage)
BLOB_READ_WRITE_TOKEN=""

# Vercel Cron auth (see plan §8 Phase 7)
CRON_SECRET="generate-with: openssl rand -base64 32"

# Awe (AI Career & Professional Growth Partner) — Anthropic Claude
ANTHROPIC_API_KEY=""
AWE_LLM_PROVIDER="anthropic"
AWE_ANTHROPIC_MODEL="claude-sonnet-5"
