// Facilit8 — Prisma schema
// See plan: C:\Users\DELL\.claude\plans\tingly-knitting-engelbart.md

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  FACILITATOR
  EVENT_MANAGER
  PROFESSIONAL
  ADMIN
}

enum OrgMemberRole {
  OWNER
  MANAGER
  MEMBER
}

// Only meaningful when Role is ADMIN. Defaults to SUPER_ADMIN so the migration that adds
// this column doesn't strip access from admins that already exist — new support-tier admins
// are created explicitly with SUPPORT_ADMIN via /admin/admins.
enum AdminTier {
  SUPER_ADMIN
  SUPPORT_ADMIN
}

enum OrgMembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum EventApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CoFacilitatorStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum NotificationType {
  EVENT_UPDATE
  BID_RECEIVED
  BID_ACCEPTED
  BID_REJECTED
  PAYMENT_CONFIRMED
  CHAT_MESSAGE
  EVENT_REMINDER
  KYC_STATUS
  WEBHOOK_ALERT
  MERGED_TRAINING_FUNDED
  SYSTEM
  AWE_SUBSCRIPTION_RENEWED
  AWE_SUBSCRIPTION_PAYMENT_FAILED
  AWE_TRAINING_MATCH
}

enum TrainingPaymentTargetType {
  TRAINING_EVENT
  MERGED_TRAINING_EVENT
}

enum TrainingPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TransactionType {
  FUNDING
  PAYOUT
  WITHDRAWAL
  CHAT_PAYMENT
  INTERNAL_TRANSFER
  FEE
  AWE_SUBSCRIPTION
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum PlatformFeeScope {
  FACILITATOR_PAYOUT
  CHAT_ACCESS
  WITHDRAWAL
  MERGED_TRAINING_PAYOUT
}

enum AweSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AweMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ---------- Auth / Wallet ----------

model User {
  id                 String  @id @default(cuid())
  email              String  @unique
  passwordHash       String
  role               Role
  adminTier          AdminTier? @default(SUPER_ADMIN)
  firstName          String
  lastName           String
  middleName         String?
  slug               String  @unique
  mobilePhone        String  @unique
  organization       String?
  rcNumber           String? @unique
  specialization     String?
  qualification      String?
  travel             Boolean @default(false)
  experience         String?
  profileDescription String?
  state              String?
  localGovt          String?
  address            String?
  profileImageUrl    String?
  cvUrl              String?
  certificateUrl     String?

  // Onboarding wizard (post-signup) — null means not yet completed. Users can skip and
  // finish later, so this never blocks access to the product, only shows a redirect nudge.
  // onboardingSkippedAt distinguishes "chose to skip, don't force the redirect again" from
  // "never even started" (both leave onboardingCompletedAt null).
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?

  // KYC
  bvn             String?
  dateOfBirth     DateTime?
  gender          Gender?
  kycVerified     Boolean   @default(false)
  kycFailedReason String?
  kycTier         Int       @default(0)

  // Anchor linkage — own virtual account (for receiving funds)
  anchorCustomerId     String? @unique
  anchorCounterpartyId String? @unique
  depositAccountId     String? @unique
  anchorAccountId      String? @unique
  anchorVaId           String? @unique
  vaAccountNumber      String?
  vaAccountName        String?
  vaBankName           String?
  vaCreationFailed     Boolean @default(false)
  vaFailureReason      String?

  // Linked external bank account (withdrawal destination, collected at signup;
  // anchorCounterpartyId above is Anchor's CounterParty record for this account)
  linkedBankCode      String?
  linkedBankName      String?
  linkedAccountNumber String?
  linkedAccountName   String?

  // Self-service soft delete — CBN record-retention rules mean the row (and all related
  // financial/history data) must never actually be deleted. Null means active. Login is
  // blocked while set; reactivation happens on a subsequent login attempt with the correct
  // password, not automatically.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  virtualAccount      VirtualAccount?
  passwordResetTokens   PasswordResetToken[]
  accountRecoveryTokens AccountRecoveryToken[]
  transactions        Transaction[]

  eventsAsCompany          TrainingEvent[]   @relation("CompanyEvents")
  eventsSelectedAsTrainer  TrainingEvent[]   @relation("SelectedTrainer")
  applications             Application[]     @relation("TrainerApplications")
  notifications            Notification[]
  reviewsGiven             Review[]          @relation("ReviewsGiven")
  reviewsReceived          Review[]          @relation("ReviewsReceived")
  trainingPaymentsReceived TrainingPayment[] @relation("FacilitatorPayments")
  disputesRaised           Dispute[]         @relation("DisputesRaised")
  disputesResolved         Dispute[]         @relation("DisputesResolved")

  conversationsAsManager         Conversation[]      @relation("ManagerConversations")
  conversationsAsFacilitator     Conversation[]      @relation("FacilitatorConversations")
  messages                       Message[]
  facilitatorAccessAsUser        FacilitatorAccess[] @relation("AccessAsUser")
  facilitatorAccessAsFacilitator FacilitatorAccess[] @relation("AccessAsFacilitator")

  mergedTrainingEventsInitiated   MergedTrainingEvent[]       @relation("Initiator")
  mergedTrainingSelectedAsTrainer MergedTrainingEvent[]       @relation("SelectedTrainerMerged")
  mergedTrainingInvites           MergedTrainingInvite[]
  mergedTrainingParticipations    MergedTrainingParticipant[]
  mergerApplications              MergerApplication[]
  bidVotes                        BidVote[]
  mergedTrainingCoFacilitations   MergedTrainingCoFacilitator[]

  organizationMemberships OrganizationMembership[]
  facilitatorSkills       FacilitatorSkill[]

  aweSubscription  AweSubscription?
  aweConversations AweConversation[]
  aweCareerProfile AweCareerProfile?

  employmentHistory       EmploymentHistory[]
  educationHistory        EducationHistory[]
  professionalDevelopment ProfessionalDevelopment[]

  facilitatorProfile       FacilitatorProfile?
  facilitationSkillRatings FacilitationSkillRating[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// For users whose Anchor provisioning is incomplete: either customer creation failed
// outright (vaCreationFailed on User — e.g. the historical leading-"+" phone bug, now fixed
// in code but not retroactively applied to already-broken rows), or customer creation
// succeeded but the CounterParty never got created because linkedBankCode/etc. were never
// collected (Professionals were exempt from bank fields at signup until later — see
// anchor-provisioning.service.ts's silent-skip condition). Same trust model as
// PasswordResetToken: token possession is the auth factor, no login required to redeem.
model AccountRecoveryToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model VirtualAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String   @default("anchor")
  accountNumber String
  accountName   String?
  bankName      String
  accountId     String
  currency      String   @default("NGN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Local audit ledger; live Anchor deposit-account balance is the source of truth for
// actual spendable funds (fixes Django's User.wallet_balance, which referenced a
// relation that never existed in that codebase).
model Transaction {
  id                           String            @id @default(cuid())
  userId                       String
  user                         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                         TransactionType
  status                       TransactionStatus @default(PENDING)
  amount                       Decimal           @db.Decimal(14, 2)
  feeAmount                    Decimal?          @db.Decimal(14, 2)
  netAmount                    Decimal?          @db.Decimal(14, 2)
  currency                     String            @default("NGN")
  reference                    String            @unique
  anchorTransferId             String?
  counterpartyAccountNumber    String?
  counterpartyBankCode         String?
  description                  String?
  relatedTrainingEventId       String?
  relatedMergedTrainingEventId String?
  relatedConversationId        String?
  relatedAweSubscriptionId     String?
  metadata                     Json?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([reference])
}

// Fixes Django's duplicate PlatformFee / PlatformFeeMergerTraining models.
model PlatformFee {
  id            String           @id @default(cuid())
  scope         PlatformFeeScope
  percentage    Decimal          @db.Decimal(5, 2)
  isActive      Boolean          @default(true)
  effectiveFrom DateTime         @default(now())
  createdAt     DateTime         @default(now())

  @@index([scope, isActive])
}

// ---------- Core marketplace ----------

model TrainingEvent {
  id                     String              @id @default(cuid())
  companyId              String
  company                User                @relation("CompanyEvents", fields: [companyId], references: [id], onDelete: Cascade)
  title                  String
  startDate              DateTime
  endDate                DateTime
  location               String
  flyerImageUrl          String?
  capacity               Int
  skillType              String
  expectedTrainingSkills String?
  eventObjective         String?
  delegatesLevel         String
  eventCategory          String
  venueType              String
  seriesLength           Int?
  durationDays           Int
  eventExpiryDate        DateTime
  eventDetails           String?
  trainingMaterials      Boolean             @default(false)
  trainingBudget         Decimal             @db.Decimal(14, 2)
  approval               EventApprovalStatus @default(PENDING)
  isAvailable            Boolean             @default(true)
  paymentConfirmed       Boolean             @default(false)
  selectedTrainerId      String?
  selectedTrainer        User?               @relation("SelectedTrainer", fields: [selectedTrainerId], references: [id])
  slug                   String              @unique
  isCompleted            Boolean             @default(false)
  isPaid                 Boolean             @default(false)
  completedAt            DateTime?
  reminderSentAt         DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  applications Application[]
  reviews      Review[]
  payments     TrainingPayment[] @relation("TrainingEventPayments")
  disputes     Dispute[]         @relation("TrainingEventDisputes")
  milestones   Milestone[]

  @@index([companyId])
  @@index([approval, isAvailable])
}

model Application {
  id                String            @id @default(cuid())
  trainerId         String
  trainer           User              @relation("TrainerApplications", fields: [trainerId], references: [id], onDelete: Cascade)
  trainingEventId   String
  trainingEvent     TrainingEvent     @relation(fields: [trainingEventId], references: [id], onDelete: Cascade)
  appliedAt         DateTime          @default(now())
  courseBreakdown   String?
  objective         String?
  classActivities   String?
  budgetPerDelegate Decimal           @db.Decimal(14, 2)
  status            ApplicationStatus @default(PENDING)
  isSelected        Boolean           @default(false)
  slug              String            @unique

  @@unique([trainerId, trainingEventId])
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  message          String
  notificationType NotificationType
  isRead           Boolean          @default(false)
  link             String?
  slug             String           @unique
  createdAt        DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model Review {
  id              String        @id @default(cuid())
  reviewerId      String
  reviewer        User          @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId      String
  reviewee        User          @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  trainingEventId String
  trainingEvent   TrainingEvent @relation(fields: [trainingEventId], references: [id], onDelete: Cascade)
  rating          Int
  feedback        String?
  createdAt       DateTime      @default(now())
  // Rating 1-5 range is enforced by a raw-SQL CHECK constraint (Prisma has no schema-level
  // CHECK) — see migration 20260808202500_add_check_constraints.

  @@unique([reviewerId, trainingEventId])
}

// Replaces Django's generic-FK polymorphism (ContentType) with an explicit discriminator
// + nullable FKs. A raw-SQL CHECK enforcing "exactly one of trainingEventId/mergedTrainingEventId
// is set, matching targetType" is applied in migration 20260808202500_add_check_constraints.
model TrainingPayment {
  id                    String                    @id @default(cuid())
  targetType            TrainingPaymentTargetType
  trainingEventId       String?
  trainingEvent         TrainingEvent?            @relation("TrainingEventPayments", fields: [trainingEventId], references: [id])
  mergedTrainingEventId String?
  mergedTrainingEvent   MergedTrainingEvent?      @relation("MergedTrainingEventPayments", fields: [mergedTrainingEventId], references: [id])
  facilitatorId         String
  facilitator           User                      @relation("FacilitatorPayments", fields: [facilitatorId], references: [id])
  grossAmount           Decimal                   @db.Decimal(14, 2)
  feeAmount             Decimal                   @db.Decimal(14, 2)
  netAmount             Decimal                   @db.Decimal(14, 2)
  reference             String                    @unique
  rawResponse           Json?
  status                TrainingPaymentStatus     @default(PENDING)
  createdAt             DateTime                  @default(now())

  @@index([targetType, trainingEventId])
  @@index([targetType, mergedTrainingEventId])
}

// ---------- Chat ----------

// isActive + service-layer deactivate-then-create pattern (plus a recommended Postgres
// partial unique index on isActive=true) fixes Django's "latest row wins" ChatPricing.
model ChatPricing {
  id           String   @id @default(cuid())
  amount       Decimal  @db.Decimal(14, 2)
  durationDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  chatPayments ChatPayment[]
}

model Conversation {
  id               String    @id @default(cuid())
  eventManagerId   String
  eventManager     User      @relation("ManagerConversations", fields: [eventManagerId], references: [id], onDelete: Cascade)
  facilitatorId    String
  facilitator      User      @relation("FacilitatorConversations", fields: [facilitatorId], references: [id], onDelete: Cascade)
  slug             String    @unique
  paymentConfirmed Boolean   @default(false)
  accessGranted    Boolean   @default(false)
  accessExpiresAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages    Message[]
  chatPayment ChatPayment?

  @@unique([eventManagerId, facilitatorId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// "Ever paid this pairing" flag, distinct from Conversation's time-limited access.
model FacilitatorAccess {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("AccessAsUser", fields: [userId], references: [id], onDelete: Cascade)
  facilitatorId String
  facilitator   User     @relation("AccessAsFacilitator", fields: [facilitatorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([userId, facilitatorId])
}

model ChatPayment {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pricingId      String?
  pricing        ChatPricing? @relation(fields: [pricingId], references: [id])
  expiresAt      DateTime
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
}

// ---------- Payments / Anchor ----------

// Idempotency + audit log for inbound Anchor webhooks.
model AnchorWebhookEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique
  eventType       String
  payload         Json
  receivedAt      DateTime @default(now())
  processed       Boolean  @default(false)
  processingError String?

  @@index([eventType])
}

// ---------- Merged (pooled/crowdfunded) training ----------

model MergedTrainingEvent {
  id                String              @id @default(cuid())
  initiatorId       String
  initiator         User                @relation("Initiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime
  location          String
  delegatesLevel    String
  eventCategory     String
  venueType         String
  totalSlots        Int
  pricePerDelegate  Decimal             @db.Decimal(14, 2)
  deadline          DateTime
  isInviteOnly      Boolean             @default(false)
  isFullyFunded     Boolean             @default(false)
  isPostedToBoard   Boolean             @default(false)
  cancelled         Boolean             @default(false)
  selectedTrainerId String?
  selectedTrainer   User?               @relation("SelectedTrainerMerged", fields: [selectedTrainerId], references: [id])
  approval          EventApprovalStatus @default(PENDING)
  paymentConfirmed  Boolean             @default(false)
  votingNotified    Boolean             @default(false)
  slug              String              @unique
  isCompleted       Boolean             @default(false)
  isPaid            Boolean             @default(false)
  completedAt       DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  invites        MergedTrainingInvite[]
  participants   MergedTrainingParticipant[]
  applications   MergerApplication[]
  payments       TrainingPayment[]             @relation("MergedTrainingEventPayments")
  coFacilitators MergedTrainingCoFacilitator[]
  disputes       Dispute[]                     @relation("MergedTrainingEventDisputes")

  @@index([initiatorId])
  @@index([isPostedToBoard, isFullyFunded])
}

// Facilitator-initiated sessions only — the initiating facilitator can invite fellow
// facilitators to co-deliver and split the payout. Requires confirmation before counting
// toward the split (unlike MergedTrainingInvite, which needs no accept step), so this is a
// separate model rather than a status field bolted onto MergedTrainingInvite.
model MergedTrainingCoFacilitator {
  id                    String              @id @default(cuid())
  mergedTrainingEventId String
  mergedTrainingEvent   MergedTrainingEvent @relation(fields: [mergedTrainingEventId], references: [id], onDelete: Cascade)
  facilitatorId         String
  facilitator           User                @relation(fields: [facilitatorId], references: [id], onDelete: Cascade)
  status                CoFacilitatorStatus @default(PENDING)
  invitedAt             DateTime            @default(now())
  respondedAt           DateTime?

  @@unique([mergedTrainingEventId, facilitatorId])
}

// Explicit join table, replacing Django's M2M `invited_companies`.
model MergedTrainingInvite {
  id                    String              @id @default(cuid())
  mergedTrainingEventId String
  mergedTrainingEvent   MergedTrainingEvent @relation(fields: [mergedTrainingEventId], references: [id], onDelete: Cascade)
  companyId             String
  company               User                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedAt             DateTime            @default(now())

  @@unique([mergedTrainingEventId, companyId])
}

model MergedTrainingParticipant {
  id                    String              @id @default(cuid())
  mergedTrainingEventId String
  mergedTrainingEvent   MergedTrainingEvent @relation(fields: [mergedTrainingEventId], references: [id], onDelete: Cascade)
  companyId             String
  company               User                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numDelegates          Int
  amountPaid            Decimal             @default(0) @db.Decimal(14, 2)
  hasPaid               Boolean             @default(false)
  paidAt                DateTime?
  createdAt             DateTime            @default(now())

  @@unique([mergedTrainingEventId, companyId])
}

// Same bid shape as Application, scoped to merged events. Kept as a separate model
// (not unified into a polymorphic Bid) since that wasn't in the original bug list —
// flagged in the plan as an optional future refactor, not done unilaterally.
model MergerApplication {
  id                    String              @id @default(cuid())
  trainerId             String
  trainer               User                @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  mergedTrainingEventId String
  mergedTrainingEvent   MergedTrainingEvent @relation(fields: [mergedTrainingEventId], references: [id], onDelete: Cascade)
  appliedAt             DateTime            @default(now())
  courseBreakdown       String?
  objective             String?
  classActivities       String?
  budgetPerDelegate     Decimal             @db.Decimal(14, 2)
  status                ApplicationStatus   @default(PENDING)
  isSelected            Boolean             @default(false)
  slug                  String              @unique

  votes BidVote[]

  @@unique([trainerId, mergedTrainingEventId])
}

model BidVote {
  id                  String            @id @default(cuid())
  voterId             String
  voter               User              @relation(fields: [voterId], references: [id], onDelete: Cascade)
  mergerApplicationId String
  mergerApplication   MergerApplication @relation(fields: [mergerApplicationId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([voterId, mergerApplicationId])
}

// ---------- Landing page / Admin CMS ----------

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

model Service {
  id        String   @id @default(cuid())
  icon      String?
  title     String
  info      String?
  summary   String?
  imageUrl  String?
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countUps CountUp[]
}

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  position     String
  linkedinUrl  String?
  twitterUrl   String?
  facebookUrl  String?
  instagramUrl String?
  imageUrl     String?
  bio          String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  countUps CountUp[]
}

model CountUp {
  id           String      @id @default(cuid())
  trait        String
  level        Int
  summary      String?
  serviceId    String?
  service      Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  teamMemberId String?
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
}

// Singleton via fixed id + upsert.
model AboutUs {
  id                   Int      @id @default(1)
  title                String
  description          String
  videoUrl             String?
  mission              String?
  vision               String?
  testimonialImageUrls String[]
  updatedAt            DateTime @updatedAt
}

// Singleton via fixed id + upsert. Admin-editable contact info shown on /contact.
model SiteSettings {
  id        Int      @id @default(1)
  email     String
  phone     String?
  address   String?
  updatedAt DateTime @updatedAt
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

// Privacy / Terms static legal pages.
model LegalPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  contentHtml String
  updatedAt   DateTime @updatedAt
}

// Admin-editable copy for the "home" | "about" | "services" | "careers" marketing pages —
// each page's `blocks` shape is specific to that page (mirrors its current hardcoded JSX
// structure exactly), not a generic block-builder. Public pages fall back to their
// hardcoded defaults when no row exists yet for that page, so nothing regresses before an
// admin has edited anything. Unrelated to HomepageContent/PricingContent below (dead
// scaffolding for a future redesign, never wired up) — left untouched.
model MarketingPageContent {
  id        String   @id @default(cuid())
  page      String   @unique
  blocks    Json
  updatedAt DateTime @updatedAt
}

// Replaces Django's ~55-field Homepage model with a block/JSON structure — this page
// gets redesigned in a later phase anyway, so a flat 55-column table isn't worth porting.
model HomepageContent {
  id        Int      @id @default(1)
  blocks    Json
  updatedAt DateTime @updatedAt
}

// Replaces Django's ~40-field Pricing model, same rationale as HomepageContent.
model PricingContent {
  id        Int      @id @default(1)
  tiers     Json
  updatedAt DateTime @updatedAt
}

// ---------- Organizations (formalizes the free-text "organization" field so Professional
// users have real entities to affiliate with) ----------

model Organization {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Business (CAC) verification — Professionals may only affiliate with a VERIFIED org.
  cacNumber                String?
  businessBvn              String?
  industry                 String?
  registrationType         BusinessRegistrationType?
  dateOfRegistration       DateTime?
  addressLine1             String?
  addressCity              String?
  addressState             String?
  anchorBusinessCustomerId String?                   @unique
  verificationStatus       OrgVerificationStatus     @default(UNVERIFIED)
  verificationFailedReason String?

  memberships OrganizationMembership[]
  documents   OrganizationDocument[]
  profile     OrganizationProfile?
}

enum BusinessRegistrationType {
  PRIVATE_INCORPORATED
  INCORPORATED_TRUSTEES
  BUSINESS_NAME
  FREE_ZONE
  GOV
  PRIVATE_INCORPORATED_GOV
  COOPERATIVE_SOCIETY
  PUBLIC_INCORPORATED
}

enum OrgVerificationStatus {
  UNVERIFIED
  PENDING
  AWAITING_DOCUMENTS
  VERIFIED
  REJECTED
}

enum OrgDocumentStatus {
  REQUIRED
  UPLOADED
  APPROVED
  REJECTED
}

// Mirrors Anchor's per-document KYB lifecycle: each row is a document Anchor told us is
// required (via the customer.identification.awaitingDocument webhook), which we then
// upload and track through to approval/rejection via document.approved/document.rejected.
model OrganizationDocument {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  anchorDocumentId String            @unique
  documentType     String
  status           OrgDocumentStatus @default(REQUIRED)
  rejectionReason  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId])
}

// A user's link to an Organization. The Event Manager who registers an org's name first
// becomes its OWNER (auto-approved); everyone else who selects that org at signup gets a
// PENDING membership the owner must approve from their dashboard.
model OrganizationMembership {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgMemberRole       @default(MEMBER)
  status         OrgMembershipStatus @default(PENDING)
  requestedAt    DateTime            @default(now())
  respondedAt    DateTime?

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
}

// ---------- Skills (admin-managed taxonomy for Facilitator profiles) ----------

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  facilitators      FacilitatorSkill[]
  aweCareerProfiles AweCareerProfileSkill[]
}

model FacilitatorSkill {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
}

// ---------- Awe (AI Career & Professional Growth Partner) ----------

// Single configurable-row pricing, same "isActive latest-row-wins" convention as
// ChatPricing/PlatformFee. isFree lets an admin make Awe free for everyone without
// deleting the price history.
model AwePricing {
  id           String   @id @default(cuid())
  monthlyPrice Decimal  @db.Decimal(14, 2)
  durationDays Int      @default(30)
  isFree       Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions AweSubscription[]
}

// Per-user current subscription state. Transaction rows (via relatedAweSubscriptionId)
// are the billing history; this is just "where things stand right now."
model AweSubscription {
  id                  String                @id @default(cuid())
  userId              String                @unique
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              AweSubscriptionStatus @default(ACTIVE)
  pricingId           String?
  pricing             AwePricing?           @relation(fields: [pricingId], references: [id])
  currentPeriodStart  DateTime              @default(now())
  currentPeriodEnd    DateTime
  nextBillingAt       DateTime?
  cancelAtPeriodEnd   Boolean               @default(false)
  canceledAt          DateTime?
  failedPaymentCount  Int                   @default(0)
  lastPaymentFailedAt DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status, nextBillingAt])
}

// Private, single-user conversation thread — distinct from the human-to-human
// Conversation model above. No slug: always accessed by id, behind auth.
model AweConversation {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages AweMessage[]

  @@index([userId, updatedAt])
}

model AweMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   AweConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AweMessageRole
  content        String
  toolCalls      Json?
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
}

// Structured (not Json-blob) career memory so fields stay individually queryable and
// incrementally updatable across conversations, per the product brief's "Awe should
// remember professional context" requirement.
model AweCareerProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRole            String?
  industry               String?
  yearsExperience        Int?
  currentEmployer        String?
  targetRole             String?
  targetIndustry         String?
  careerGoals            String?
  strengths              String?
  developmentAreas       String?
  preferredLearningStyle String?

  // Onboarding wizard's "Professional Profile" step — quick-answer fields, distinct from
  // the detailed dated records in EducationHistory/ProfessionalDevelopment.
  highestEducationLevel  String?
  professionalMemberships String[]
  certifications          String[]
  languagesSpoken         String[]

  // "Career Direction" step.
  careerGoalTags   String[]
  targetCareerLevel String?
  targetTimeline    String?
  longTermAmbition  String?
  topStrengths      String[]
  skillsToImprove   String[]
  weakSkills        String[]
  skillsToAcquire   String[]
  challengeTags     String[]
  challengeOther    String?

  // "Learning Preferences" step.
  learningFormats     String[]
  availableLearningTime String?
  preferredSchedule   String[]
  preferredDelivery   String?

  // "Meet Awe" step — free text the structured fields above can't anticipate.
  tellAweText String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  skills AweCareerProfileSkill[]
}

// Joins the career profile into the existing admin-curated Skill taxonomy rather than
// storing free-text skill names, so Awe's view of a user's skills stays consistent with
// the rest of the app (facilitator skills, signup, etc).
model AweCareerProfileSkill {
  id          String           @id @default(cuid())
  profileId   String
  profile     AweCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency String?

  @@unique([profileId, skillId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  VOLUNTEER
  SELF_EMPLOYED
}

// Onboarding "Your Background" step — repeatable, multiple rows per user. Gives Awe a
// timeline of career progression rather than just a single current-job free-text field.
model EmploymentHistory {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  jobTitle         String
  industry         String?
  employmentType   EmploymentType
  location         String?
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean        @default(false)
  responsibilities String?
  achievements     String?
  skillsDeveloped  String[]
  majorProjects    String?
  teamSize         Int?
  reasonForLeaving String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
}

model EducationHistory {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        String
  qualification      String
  fieldOfStudy       String?
  startDate          DateTime
  endDate            DateTime?
  grade              String?
  relevantCoursework String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

enum ProfessionalDevelopmentType {
  COURSE
  TRAINING
  CERTIFICATION
  WORKSHOP
  CONFERENCE
}

enum ProfessionalDevelopmentSource {
  MANUAL
  FACILIT8_AUTO
}

// Courses/certifications/workshops outside the structured Employment/Education history.
// MANUAL rows are entered by the user (onboarding or later); FACILIT8_AUTO rows are
// created automatically when a Facilitator completes a delivery on the platform (Stage 2).
model ProfessionalDevelopment {
  id                            String                         @id @default(cuid())
  userId                        String
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                          ProfessionalDevelopmentType
  title                         String
  provider                      String?
  dateCompleted                 DateTime
  skillsAcquired                String[]
  expiryDate                    DateTime?
  source                        ProfessionalDevelopmentSource @default(MANUAL)
  relatedTrainingEventId        String?
  relatedMergedTrainingEventId  String?
  createdAt                     DateTime                       @default(now())

  @@index([userId])
}

// Onboarding wizard's role-specific step (Facilitator branch) — 1:1 with User, only
// meaningful for role FACILITATOR. "Areas of expertise" deliberately reuses the existing
// FacilitatorSkill join rather than duplicating it here.
model FacilitatorProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearsFacilitating        Int?
  sessionsDelivered        Int?
  delegatesTrained         Int?
  typicalAudienceSize      String?
  typicalAudienceSeniority String?
  trainingFormats          String[]
  industriesServed         String[]
  canTrainNow              String[]
  wantToTrain              String[]
  facilitatorGoals         String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

enum FacilitationSkillName {
  PUBLIC_SPEAKING
  FACILITATION
  ADULT_LEARNING
  INSTRUCTIONAL_DESIGN
  WORKSHOP_DESIGN
  STORYTELLING
  EXECUTIVE_FACILITATION
  VIRTUAL_FACILITATION
  TRAINING_EVALUATION
  PRESENTATION
  COACHING
  CONSULTING
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// A fixed facilitation-craft skill catalog, deliberately separate from the admin-curated
// Skill taxonomy (which models subject-matter "areas of expertise", not facilitation
// technique proficiency).
model FacilitationSkillRating {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       FacilitationSkillName
  proficiency ProficiencyLevel
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([userId, skill])
}

// Onboarding wizard's role-specific step (Event Manager branch) — 1:1 with Organization
// (shared by every member of that org), not User. Whoever fills this in during their own
// onboarding is contributing to the org's shared profile, same as updating org identity
// fields elsewhere.
model OrganizationProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identity extras
  organizationType  String?
  website           String?
  employeeCountBand String?
  locations         String[]
  yearEstablished   Int?
  departments       String[]

  // Workforce profile
  workforceLevels String[]

  // Training needs + workforce challenges
  trainingNeeds       String[]
  workforceChallenges String[]

  // Training requirements
  preferredFormat   String?
  preferredLocation String?
  preferredSchedule String[]
  trainingFrequency String?
  typicalDuration   String?
  typicalClassSize  String?
  budgetRange       String?
  budgetCurrency    String  @default("NGN")
  typicalAudience   String?

  // Strategic priorities — biggestChallenge is the single most valuable input to Awe's
  // organizational intelligence per the product brief.
  strategicInitiatives String[]
  skillsNeeded         String[]
  biggestChallenge     String?

  // Learning culture
  learningCulture       String?
  participationBarriers String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tracks the last successful run of each background job, so a silently-stopped cron (e.g.
// the GitHub Actions workflow that drives webhook-reconciliation, since Vercel Hobby only
// allows daily cron) can be surfaced as stale in the admin panel instead of failing silently.
model CronRun {
  jobName   String   @id
  lastRunAt DateTime
}

enum DisputeTargetType {
  TRAINING_EVENT
  MERGED_TRAINING_EVENT
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  RESOLVED_NO_ACTION
}

// MVP: raise/track/resolve only. Refunding is a manual admin action, gated to disputes where
// the escrow amount is confirmed still sitting in the settlement account (event/session not
// yet paid out) — there's no automatic clawback of funds already paid to a facilitator, since
// reversing a completed Anchor transfer isn't something to do speculatively from a dispute
// resolution flow. A dispute against an already-paid-out event stays flagged for manual,
// off-platform follow-up. See raise/resolve actions in lib/actions/dispute.actions.ts.
model Dispute {
  id                    String               @id @default(cuid())
  targetType            DisputeTargetType
  trainingEventId       String?
  trainingEvent         TrainingEvent?       @relation("TrainingEventDisputes", fields: [trainingEventId], references: [id])
  mergedTrainingEventId String?
  mergedTrainingEvent   MergedTrainingEvent? @relation("MergedTrainingEventDisputes", fields: [mergedTrainingEventId], references: [id])
  raisedById            String
  raisedBy              User                 @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  reason                String
  status                DisputeStatus        @default(OPEN)
  resolutionNotes       String?
  resolvedById          String?
  resolvedBy            User?                @relation("DisputesResolved", fields: [resolvedById], references: [id])
  resolvedAt            DateTime?
  createdAt             DateTime             @default(now())

  @@index([targetType, trainingEventId])
  @@index([targetType, mergedTrainingEventId])
  @@index([status])
}

// Opt-in, implicit rather than a flag: an event with zero Milestone rows pays out exactly
// as it always has (payFacilitatorForEvent, one lump sum). An event with milestones added
// pays out per-milestone instead (payFacilitatorForMilestone) — payFacilitatorForEvent
// refuses to run at all once any milestone exists, so the two paths can never double-pay
// the same escrowed budget. Existing events are entirely unaffected since none have rows
// here. TrainingEvent only (not MergedTrainingEvent) for this first pass.
model Milestone {
  id              String        @id @default(cuid())
  trainingEventId String
  trainingEvent   TrainingEvent @relation(fields: [trainingEventId], references: [id], onDelete: Cascade)
  title           String
  amount          Decimal       @db.Decimal(14, 2)
  order           Int
  isPaidOut       Boolean       @default(false)
  paidOutAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([trainingEventId])
}
